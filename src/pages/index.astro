---
import BaseLayout from '../layouts/BaseLayout.astro';
import { activeProducts, categories, slugify } from '../data/products';
import ProductCard from '../components/ProductCard.astro';
const featured = activeProducts.filter((p) => p.featured);
const trending = activeProducts.filter((p) => p.trending);
const categoryIcons = ['⚡','⌁','♫','✧','⌂','◒','☼','➤','✿','⌖','◇'];
---
<BaseLayout>
  <main id="main">
    <section class="hero shell">
      <div class="hero-copy"><span class="eyebrow"><i></i> GOOD FINDS, BETTER DAYS</span><h1>Find your next<br /><em>everyday favourite.</em></h1><p>Useful gadgets, home picks and little upgrades—curated from the marketplaces you know.</p><a class="button button-dark" href="#discover">Explore the collection <span>↘</span></a><div class="hero-note"><span class="note-icon">✦</span><span>Curated with care<br /><b>Made for everyday living</b></span></div></div>
      <div class="hero-art" aria-label="Illustration of thoughtfully selected shopping finds" role="img"><div class="sun-orbit"></div><div class="art-label label-one">THE DAILY EDIT <span>✦</span></div><div class="art-card"><div class="art-product art-power"><span class="power-screen">84<span>%</span></span><span class="power-cable"></span></div><div class="art-spark">✦</div><div class="art-caption">Good things<br />within reach.</div></div><div class="art-sticker">GOOD<br />FINDS <span>✷</span></div><div class="art-label label-two">SHOP SMART, LIVE WELL</div></div>
    </section>
    <section class="trust-strip shell"><span><b>✳</b> Curated marketplace finds</span><span><b>↗</b> Shop directly with retailers</span><span><b>♡</b> New discoveries to explore</span></section>
    <section class="category-section shell" aria-labelledby="category-heading"><div class="section-heading"><div><span class="eyebrow">A PLACE TO START</span><h2 id="category-heading">Browse by category</h2></div><a class="text-link" href="/categories/">See all categories <span>→</span></a></div><div class="category-grid">{categories.map((category, i) => <a class="category-chip" href={`/categories/${slugify(category)}/`}><span class="category-icon">{categoryIcons[i]}</span><span>{category}</span><span class="chip-arrow">↗</span></a>)}</div></section>
    <section class="products-section shell" id="discover"><div class="section-heading products-heading"><div><span class="eyebrow">THE GOOD FINDS EDIT</span><h2>Worth a closer look</h2><p>Curated picks for useful upgrades and everyday moments.</p></div><form class="search-form" role="search" action="/" method="get"><label class="visually-hidden" for="product-search">Search deals</label><span aria-hidden="true">⌕</span><input id="product-search" name="q" type="search" placeholder="Search deals..." /><button aria-label="Search">→</button></form></div><div class="filter-row" role="group" aria-label="Filter products"><button class="filter-pill active" data-filter="all">All finds</button><button class="filter-pill" data-filter="trending">Trending</button><button class="filter-pill" data-filter="Power & Charging">Power & Charging</button><button class="filter-pill" data-filter="Home & Living">Home & Living</button></div><div class="product-grid" id="product-grid">{featured.map((product) => <ProductCard product={product} />)}</div><p class="empty-state" hidden>No finds match that search. Try another term or browse all categories.</p></section>
    <section class="feature-banner shell"><div><span class="eyebrow">A LITTLE MORE INTENTIONAL</span><h2>Good finds.<br /><em>Clear choices.</em></h2><p>We bring interesting marketplace picks together, so you can explore and decide what works for you.</p><a class="button button-light" href="/about/">Get to know us <span>→</span></a></div><div class="banner-art"><span class="banner-star">✳</span><span class="banner-ring"></span><span class="banner-word">thoughtfully<br />found.</span></div></section>
    <section class="disclosure-note shell"><span class="disclosure-icon">ⓘ</span><p><b>A note about affiliate links</b><br />Some links on this site are affiliate links. If you buy through them, we may earn a commission at no extra cost to you. <a href="/affiliate-disclosure/">Learn more</a>.</p></section>
  </main>
  <script>
    const cards = [...document.querySelectorAll('[data-product-card]')];
    const buttons = [...document.querySelectorAll('[data-filter]')];
    const search = document.querySelector('#product-search');
    const empty = document.querySelector('.empty-state');
    const params = new URLSearchParams(location.search);
    if (search && params.get('q')) search.value = params.get('q');
    let selected = 'all';
    const apply = () => {
      const query = search?.value.trim().toLowerCase() || '';
      let shown = 0;
      cards.forEach((card) => {
        const matchesText = !query || (card.textContent || '').toLowerCase().includes(query);
        const matchesFilter = selected === 'all' || (selected === 'trending' ? card.dataset.trending === 'true' : card.dataset.category === selected);
        card.hidden = !(matchesText && matchesFilter);
        if (!card.hidden) shown++;
      });
      if (empty) empty.hidden = shown !== 0;
    };
    buttons.forEach((button) => button.addEventListener('click', () => {
      selected = button.dataset.filter || 'all';
      buttons.forEach((item) => item.classList.toggle('active', item === button));
      apply();
    }));
    search?.addEventListener('input', apply);
    if (params.get('type') === 'trending') { selected = 'trending'; buttons.forEach((b) => b.classList.toggle('active', b.dataset.filter === 'trending')); }
    apply();
  </script>
</BaseLayout>
