---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { activeProducts, categories, slugify } from '../../data/products';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: slugify(category) },
    props: { category },
  }));
}

const { category } = Astro.props;
const items = activeProducts.filter((product) => product.category === category);
---
<BaseLayout title={`${category} Deals | God First Deals`} description={`Browse curated ${category.toLowerCase()} finds from God First Deals.`}>
  <main id="main" class="shell listing-page">
    <div class="breadcrumbs"><a href="/">Home</a><span> / </span><a href="/categories/">Categories</a><span> / {category}</span></div>
    <span class="eyebrow">A PLACE TO START</span>
    <h1>{category} deals</h1>
    <p class="page-intro">Browse our curated finds in {category.toLowerCase()}.</p>
    {items.length > 0 ? (
      <div class="product-grid">
        {items.map((product) => <ProductCard product={product} />)}
      </div>
    ) : (
      <p class="empty-state">There are no active products in this category yet. Please check back soon.</p>
    )}
  </main>
</BaseLayout>
